@@ -0,0 +1,571 @@
+#!/usr/bin/env node
+/**
+ * delegate-skills · gemini-delegate · relay.mjs
+ *
+ * Dispatch a brief to Gemini CLI in headless stream-json mode. Node built-ins
+ * only; no network calls of its own, credentials, telemetry, or commits.
+ * Launches gemini and git, where.exe/taskkill on Windows, and node for --lane.
+ * Gemini authenticates and uses its own services as configured by the user.
+ *
+ * Usage:
+ *   node relay.mjs --brief <file> [options]
+ *   cat brief.txt | node relay.mjs [options]
+ *
+ * Options:
+ *   --brief <file>          Brief path; omitted means stdin.
+ *   --cd <dir>              Child working directory (default: current directory).
+ *   --lane <name>           Saved fleet lane; explicit dial flags win.
+ *   --model <id>            Optional model; omitted preserves CLI Auto/default.
+ *                           Letters, digits, and . _ : / - only.
+ *   --approval-mode <mode>  default | auto_edit | yolo | plan (default: auto_edit).
+ *   --resume <selector>     latest or positive session index from --list-sessions.
+ *   --resume-last           Alias for --resume latest; send a delta brief.
+ *   --timeout <dur>         Relay watchdog (default: 30m; h/m/s strings).
+ *   --out-dir <dir>         Artifacts (default: fresh directory in system temp).
+ *   -h, --help              Show this help.
+ *
+ * auto_edit auto-approves edit tools, not all shell actions. default may require
+ * approvals unavailable headlessly; yolo auto-approves all tools. plan is the
+ * CLI's planning mode, NOT an enforced read-only promise here (settings can
+ * downgrade it). No --read-only, sandbox, or trust bypass is configured.
+ * The brief stays on stdin; only fixed/token-validated argv reaches the Windows
+ * npm .cmd shim via shell:true. Workspace and artifact paths stay out of argv.
+ *
+ * Artifacts: brief.txt, events.jsonl, stderr.txt, nullable final.txt, result.json.
+ * Result schema: delegate-relay.result.v1; status, exitCode, signal, sessionId,
+ * finalMessage, touchedFiles (git porcelain; null if unavailable, [] if clean),
+ * requested model/approvalMode/resume, initialModel, stats, geminiVersion,
+ * timestamps, lane provenance, artifact paths, and error diagnostics on failure.
+ * finalMessage joins assistant message content; it may include intermediate
+ * narration. Completion requires a success result event AND child exit 0.
+ * Tool errors remain in events.jsonl; a recovered tool error is not alone fatal.
+ *
+ * Usage errors exit 2 before artifacts; missing gemini exits 127 WITH a result.
+ * Other outcomes: completed, failed, timeout, aborted, gemini_unavailable.
+ * Watchdog timeout is failed even if the child exits 0. POSIX signals are
+ * forwarded to the process group; Windows taskkill kills the whole tree.
+ * A hard kill of this relay on Windows is uncatchable and may leave no result.
+ */
+
+import { spawn, execFileSync, spawnSync } from "node:child_process";
+import { appendFileSync, existsSync, mkdirSync, readFileSync, renameSync, rmSync, statSync, writeFileSync } from "node:fs";
+import { join, resolve, basename, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { constants, tmpdir } from "node:os";
+import { StringDecoder } from "node:string_decoder";
+
+const DEFAULT_TIMEOUT = "30m";
+const MAX_TIMER_MS = 2_147_483_647;
+const MAX_BUFFERED_CHARS = 1_048_576;
+const VERSION_TIMEOUT_MS = 10_000;
+const STDIN_PROMPT = "Follow the task instructions provided on stdin.";
+const SAFE_TOKEN = /^[A-Za-z0-9][A-Za-z0-9._:/-]*$/;
+const APPROVAL_MODES = new Set(["default", "auto_edit", "yolo", "plan"]);
+
+function fail(message, code = 2) {
+  process.stderr.write(`relay: ${message}\n`);
+  process.exit(code);
+}
+
+function applyFleetLane(opts, flagged) {
+  if (!opts.lane) return;
+  const script = join(dirname(fileURLToPath(import.meta.url)), "../../delegate-setup/scripts/lane.mjs");
+  if (!existsSync(script)) fail("--lane requires the delegate-setup skill installed beside this relay");
+  const r = spawnSync(process.execPath, [script, "resolve", "--cwd", opts.cd, "--lane", opts.lane, "--implementer", "gemini"], {
+    encoding: "utf8", env: process.env,
+  });
+  if (r.error) fail(`lane resolve failed: ${r.error.message}`);
+  if (r.status !== 0) fail((r.stderr || "lane resolve failed").trim().replace(/^lane\.mjs:\s*/, ""));
+  let resolved;
+  try { resolved = JSON.parse(r.stdout.trim()); } catch { fail("lane resolve returned invalid JSON"); }
+  opts.laneSource = resolved.source;
+  for (const [field, value] of Object.entries(resolved.dials || {})) {
+    if (!flagged.has(field)) opts[field] = value;
+  }
+}
+
+function parseDuration(duration) {
+  const match = /^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$/.exec(duration);
+  if (!match || (!match[1] && !match[2] && !match[3])) return null;
+  try {
+    const seconds =
+      BigInt(match[1] || 0) * 3600n +
+      BigInt(match[2] || 0) * 60n +
+      BigInt(match[3] || 0);
+    const milliseconds = seconds * 1000n;
+    if (milliseconds <= 0n || milliseconds > BigInt(MAX_TIMER_MS)) return null;
+    return Number(milliseconds);
+  } catch {
+    return null;
+  }
+}
+
+function parseArgs(argv) {
+  const opts = { brief: null, cd: process.cwd(), lane: null, laneSource: null, model: null, approvalMode: "auto_edit", resume: null, timeout: DEFAULT_TIMEOUT, outDir: null };
+  const flagged = new Set();
+  for (let i = 0; i < argv.length; i += 1) {
+    const arg = argv[i];
+    const next = () => {
+      const value = argv[++i];
+      if (value === undefined) fail(`${arg} requires a value`);
+      return value;
+    };
+    switch (arg) {
+      case "-h":
+      case "--help": process.stdout.write(headerComment()); process.exit(0); break;
+      case "--brief": opts.brief = next(); break;
+      case "--cd": opts.cd = resolve(next()); break;
+      case "--lane": opts.lane = next(); break;
+      case "--model": opts.model = next(); flagged.add("model"); break;
+      case "--approval-mode": opts.approvalMode = next(); flagged.add("approvalMode"); break;
+      case "--resume":
+      case "--resume-last":
+        if (opts.resume !== null) fail("--resume and --resume-last are mutually exclusive and cannot be repeated");
+        opts.resume = arg === "--resume-last" ? "latest" : next();
+        break;
+      case "--timeout": opts.timeout = next(); flagged.add("timeout"); break;
+      case "--out-dir": opts.outDir = resolve(next()); break;
+      default: fail(`unknown option: ${arg}`);
+    }
+  }
+  applyFleetLane(opts, flagged);
+  if (opts.model !== null && !SAFE_TOKEN.test(opts.model)) fail("--model has unsupported characters (allowed: letters, digits, . _ : / -)");
+  if (!APPROVAL_MODES.has(opts.approvalMode)) fail("--approval-mode must be default, auto_edit, yolo, or plan");
+  if (opts.resume !== null && opts.resume !== "latest" && !/^[1-9][0-9]*$/.test(opts.resume)) fail("--resume must be latest or a positive session index from gemini --list-sessions");
+  if (parseDuration(opts.timeout) === null) fail(`--timeout "${opts.timeout}" is not a positive schedulable duration; use h/m/s strings (maximum ~24.8 days)`);
+  if (!existsSync(opts.cd) || !statSync(opts.cd).isDirectory()) fail(`working directory not found: ${opts.cd}`);
+  return opts;
+}
+
+function headerComment() {
+  const source = readFileSync(new URL(import.meta.url), "utf8");
+  return `${source.match(/\/\*\*([\s\S]*?)\*\//)[1].replace(/^\s*\* ?/gm, "").trim()}\n`;
+}
+
+function readBrief(opts) {
+  if (opts.brief) {
+    if (!existsSync(opts.brief)) fail(`brief file not found: ${opts.brief}`);
+    try { return readFileSync(opts.brief, "utf8"); } catch (error) { fail(`cannot read brief: ${error.message}`); }
+  }
+  if (process.stdin.isTTY) fail("no --brief given and stdin is a TTY; pass --brief <file> or pipe the brief on stdin");
+  try { return readFileSync(0, "utf8"); } catch { return ""; }
+}
+
+function killChild(child, signal = "SIGTERM") {
+  if (!child || !child.pid) return;
+  if (process.platform === "win32") {
+    if (signal !== "SIGTERM") return;
+    try {
+      execFileSync("taskkill", ["/pid", String(child.pid), "/t", "/f"], {
+        stdio: ["ignore", "ignore", "inherit"],
+      });
+    } catch {
+      // The process tree already exited.
+    }
+    return;
+  }
+  try {
+    process.kill(-child.pid, signal);
+  } catch {
+    try {
+      child.kill(signal);
+    } catch {
+      // The process group already exited.
+    }
+  }
+}
+
+function spawnShellLaunch(binary, argv, options, useShell) {
+  if (!useShell) return spawn(binary, argv, options);
+  // Node 24 warns when shell:true is paired with an args array. Gemini's dynamic
+  // values are token-validated and the fixed prompt is already quoted for cmd.exe,
+  // so serialize the command once before handing it to the shell.
+  return spawn([binary, ...argv].join(" "), { ...options, shell: true });
+}
+
+async function geminiVersion(timeoutMs, onChild) {
+  const limit = Math.min(timeoutMs, VERSION_TIMEOUT_MS);
+  const runProbe = (command, argv, options = {}) => new Promise((resolveProbe) => {
+    const useShell = options.shell === true;
+    const { shell: _shell, ...launchOptions } = options;
+    const child = spawnShellLaunch(command, argv, { stdio: ["ignore", "pipe", "pipe"], detached: process.platform !== "win32", ...launchOptions }, useShell);
+    onChild(child);
+    let stdout = "";
+    let stderr = "";
+    let settled = false;
+    let timedOut = false;
+    let timer;
+    const finish = (result) => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      resolveProbe({ stdout, stderr, ...result });
+    };
+    child.stdout.on("data", (chunk) => { stdout = (stdout + chunk).slice(-MAX_BUFFERED_CHARS); });
+    child.stderr.on("data", (chunk) => { stderr = (stderr + chunk).slice(-MAX_BUFFERED_CHARS); });
+    child.on("error", (error) => finish({ code: null, error, timedOut: false }));
+    child.on("close", (code) => finish({ code, error: null, timedOut }));
+    child.once("exit", () => {
+      const drain = setTimeout(() => { child.stdout.destroy(); child.stderr.destroy(); }, 500);
+      drain.unref();
+    });
+    timer = setTimeout(() => {
+      timedOut = true;
+      killChild(child, process.platform === "win32" ? "SIGTERM" : "SIGKILL");
+    }, limit);
+  });
+  if (process.platform === "win32") {
+    const wherePath = join(process.env.SystemRoot || process.env.WINDIR || "C:\\Windows", "System32", "where.exe");
+    const found = await runProbe(wherePath, ["gemini"]);
+    if (found.timedOut) return { version: null, error: Object.assign(new Error("where.exe gemini timed out"), { code: "ETIMEDOUT", stderr: found.stderr }) };
+    if (found.error) return { version: null, error: found.error };
+    if (found.code !== 0) return { version: null, error: null };
+  }
+  const probe = await runProbe("gemini", ["--version"], { shell: process.platform === "win32" });
+  if (probe.timedOut) return { version: null, error: Object.assign(new Error("gemini --version timed out"), { code: "ETIMEDOUT", stderr: probe.stderr }) };
+  if (probe.error?.code === "ENOENT") return { version: null, error: null };
+  if (probe.error) return { version: null, error: probe.error };
+  if (probe.code !== 0) return { version: null, error: Object.assign(new Error("gemini --version failed"), { status: probe.code, stderr: probe.stderr }) };
+  return { version: probe.stdout.trim() || "unknown", error: null };
+}
+
+function gitTouchedFiles(cwd) {
+  try {
+    const output = execFileSync("git", ["status", "--porcelain"], {
+      cwd,
+      encoding: "utf8",
+      timeout: 10_000,
+      killSignal: "SIGKILL",
+      stdio: ["ignore", "pipe", "ignore"],
+      maxBuffer: 64 * 1024 * 1024,
+    });
+    return output.split("\n").map((line) => line.trimEnd()).filter(Boolean);
+  } catch {
+    return null;
+  }
+}
+
+function buildArgv(opts) {
+  const argv = ["--output-format", "stream-json", "--approval-mode", opts.approvalMode];
+  if (opts.model) argv.push("--model", opts.model);
+  if (opts.resume) argv.push("--resume", opts.resume);
+  argv.push("--prompt", process.platform === "win32" ? `"${STDIN_PROMPT}"` : STDIN_PROMPT);
+  return argv;
+}
+
+function createEventScannerState() {
+  return { buf: "", index: 0, depth: 0, start: -1, inString: false, escaped: false };
+}
+
+function resetEventScannerState(state) {
+  Object.assign(state, { index: 0, start: -1, depth: 0, inString: false, escaped: false });
+}
+
+function consumeEventScannerCharacter(state, onObject) {
+  const { buf, index } = state;
+  const ch = buf[index];
+  if (state.inString) {
+    if (state.escaped) state.escaped = false;
+    else if (ch === "\\") state.escaped = true;
+    else if (ch === '"') state.inString = false;
+  } else if (ch === '"') {
+    if (state.depth > 0) state.inString = true;
+  } else if (ch === "{") {
+    if (state.depth === 0) state.start = index;
+    state.depth += 1;
+  } else if (ch === "}" && state.depth > 0) {
+    state.depth -= 1;
+    emitEventScannerObject(state, onObject, index);
+  }
+  state.index += 1;
+}
+
+function emitEventScannerObject(state, onObject, index) {
+  if (state.depth !== 0 || state.start === -1) return;
+  try { onObject(JSON.parse(state.buf.slice(state.start, index + 1))); } catch { /* skip malformed */ }
+  state.start = -1;
+}
+
+function discardOversizedEventScannerPartial(state) {
+  state.buf = state.buf.slice(state.start + MAX_BUFFERED_CHARS);
+  resetEventScannerState(state);
+}
+
+function retainOrClearEventScannerBuffer(state) {
+  if (state.depth > 0 && state.start !== -1) {
+    if (state.start > 0) {
+      state.buf = state.buf.slice(state.start);
+      state.index -= state.start;
+      state.start = 0;
+    }
+    return;
+  }
+  state.buf = "";
+  resetEventScannerState(state);
+}
+
+function scanEventScannerChunk(state, onObject, chunk) {
+  if (!chunk) return;
+  state.buf += chunk;
+  for (;;) {
+    while (state.index < state.buf.length) consumeEventScannerCharacter(state, onObject);
+    if (state.depth === 0 || state.start === -1 || state.buf.length - state.start <= MAX_BUFFERED_CHARS) break;
+    // A complete object may exceed the retained-input cap within this chunk.
+    // Drop only an oversized partial, then rescan its suffix so a later
+    // concatenated event is not lost.
+    discardOversizedEventScannerPartial(state);
+  }
+  retainOrClearEventScannerBuffer(state);
+}
+
+function makeEventScanner(onObject) {
+  const state = createEventScannerState();
+  return (chunk) => scanEventScannerChunk(state, onObject, chunk);
+}
+
+function recordGeminiEvent(state, event) {
+  if (event.type === "init") {
+    if (typeof event.session_id === "string") state.sessionId = event.session_id;
+    if (typeof event.model === "string") state.initialModel = event.model;
+  }
+  if (event.type === "message" && event.role === "assistant" && typeof event.content === "string") state.report += event.content;
+  if (event.type === "error" && event.severity === "error") {
+    state.errorSeen = true;
+    if (typeof event.message === "string") state.streamError = event.message;
+  }
+  if (event.type === "result") {
+    if (typeof event.status === "string") state.resultStatus = event.status;
+    if (event.status !== "success") state.errorSeen = true;
+    if (event.stats && typeof event.stats === "object") state.stats = event.stats;
+    if (typeof event.error?.message === "string") state.streamError = event.error.message;
+  }
+}
+
+function trackGeminiEvents() {
+  const state = { sessionId: null, initialModel: null, stats: null, resultStatus: null, report: "", streamError: null, errorSeen: false };
+  return { state, scan: makeEventScanner((event) => recordGeminiEvent(state, event)) };
+}
+
+function captureGeminiOutput(child, run, scan) {
+  const stdoutDecoder = new StringDecoder("utf8");
+  const stderrDecoder = new StringDecoder("utf8");
+  let stderrText = "";
